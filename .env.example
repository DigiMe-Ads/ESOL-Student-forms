DATABASE_CONNECTION_STRING=postgresql://postgres:<url-encoded-password>@db.<ref>.supabase.co:5432/postgres
# Use the session pooler when the host has no IPv6 (Supabase dashboard -> Connect -> Session pooler)
DATABASE_POOLER_URL=postgresql://postgres.<ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DB_SCHEMA=epc_feedback
API_PORT=4100
JWT_SECRET=<long random string>
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<initial password>
# Optional: max upload size in MB (defaults to 4 on Vercel because of its 4.5 MB request limit, 25 elsewhere)
# UPLOAD_LIMIT_MB=4
